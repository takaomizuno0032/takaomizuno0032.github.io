---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Research Engineer and Technology Enthusiast" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="author" content="Takao Mizuno" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="container">
			<aside class="sidebar">
				<nav class="nav">
					<a href="/" class={currentPath === "/" ? "nav-link active" : "nav-link"}>Home</a>
					<a href="/research" class={currentPath === "/research" ? "nav-link active" : "nav-link"}>Research</a>
				</nav>
			</aside>
			<main class="content">
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	:global(html) {
		font-size: 16px;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	:global(body) {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans JP", "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
		margin: 0;
		padding: 0;
		line-height: 1.6;
		color: #333;
		background-color: #fff;
	}

	.container {
		display: flex;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0;
		min-height: 100vh;
	}

	.sidebar {
		width: 200px;
		padding: 3rem 2rem;
		flex-shrink: 0;
		position: sticky;
		top: 0;
		height: 100vh;
		overflow-y: auto;
	}

	.nav {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.nav-link {
		text-decoration: none;
		color: #666;
		font-size: 0.95rem;
		padding: 0.25rem 0;
		transition: color 0.2s ease;
		font-weight: 400;
	}

	.nav-link:hover {
		color: #000;
	}

	.nav-link.active {
		color: #000;
		font-weight: 500;
	}

	.content {
		flex: 1;
		padding: 3rem 4rem;
		max-width: 800px;
	}

	:global(main h1) {
		font-size: 2rem;
		font-weight: 600;
		margin: 0 0 1rem 0;
		color: #000;
		line-height: 1.2;
	}

	:global(main h2) {
		font-size: 1.25rem;
		font-weight: 600;
		margin: 2.5rem 0 1rem 0;
		color: #000;
		line-height: 1.3;
	}

	:global(main h2:first-of-type) {
		margin-top: 0;
	}

	:global(main p) {
		margin: 1rem 0;
		color: #333;
		line-height: 1.7;
	}

	:global(main ul) {
		margin: 1rem 0;
		padding-left: 0;
		list-style: none;
	}

	:global(main li) {
		margin: 0.5rem 0;
		padding-left: 0;
		color: #333;
		line-height: 1.7;
	}

	:global(main li strong) {
		color: #000;
		font-weight: 500;
	}

	:global(main ul ul) {
		margin: 0.5rem 0 0.5rem 1.5rem;
		list-style: disc;
	}

	:global(main ul ul li) {
		margin: 0.25rem 0;
	}

	@media (max-width: 968px) {
		.container {
			flex-direction: column;
		}

		.sidebar {
			width: 100%;
			height: auto;
			position: relative;
			padding: 1.5rem 2rem;
			border-bottom: 1px solid #eee;
		}

		.nav {
			flex-direction: row;
			gap: 1.5rem;
		}

		.content {
			padding: 2rem 2rem;
		}
	}

	@media (max-width: 640px) {
		.content {
			padding: 1.5rem 1.5rem;
		}

		:global(main h1) {
			font-size: 1.75rem;
		}

		:global(main h2) {
			font-size: 1.125rem;
		}
	}
</style>
